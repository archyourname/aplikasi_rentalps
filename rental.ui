QGroupBox::title{subcontrol-origin:margin;left:10px;padding:0 4px;}
QLabel{color:#00FFE5;background:transparent;font-weight:bold;}
QLineEdit,QTextEdit,QComboBox{
 background:#1F2429;border:1px solid #4B5663;color:white;padding:6px;}
QTextEdit{border:2px solid #00FFE5;}
QPushButton{
 background:#2F353B;border:2px solid #00FFE5;color:#00FFE5;
 min-height:34px;font-weight:bold;border-radius:4px;}
QPushButton:hover{background:#374049;}
QTableWidget{
 background:#1F2429;border:1px solid #4B5663;
 gridline-color:#4B5663;color:white;}
QHeaderView::section{
 background:#2F353B;color:#00FFE5;padding:6px;border:none;}
QLabel#lblTitle{font-size: 42px; color:#00FFE5; margin-bottom:10px;}
QLabel#lblSubtitle{font-size: 18px; color:#F2F4F5; margin-bottom:30px;}
QMenuBar { background-color: #1F2429; color: white; border-bottom: 1px solid #4B5663;}
QMenuBar::item { background-color: transparent; padding: 6px 14px; }
QMenuBar::item:selected { background-color: #374049; color: #00FFE5; }
QMenu { background-color: #2F353B; color: white; border: 1px solid #4B5663; }
QMenu::item { padding: 8px 24px; }
QMenu::item:selected { background-color: #374049; color: #00FFE5; }
